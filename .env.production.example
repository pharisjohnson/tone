# =============================================================================
# Tone — PRODUCTION Environment Template (Noon Studio Africa self-host)
# =============================================================================
# Copy to `.env.production` (docker-compose.prod.yml reads it via --env-file)
# and fill in the values marked TODO. No Infisical here — this fork reads
# secrets straight from this file, same as local dev.
#
# CALL_WORKER_PREFIX / OUTBOUND_CALL_WORKER_PREFIX / OUTBOUND_CALL_HEADLESS_
# SERVICE / POD_SYNC_NAMESPACE below are Kubernetes pod-discovery labels from
# upstream's managed-cloud deploy. They're inert on a single VM (the pod-sync
# background job just no-ops/logs a harmless error each run since there's no
# k8s API to reach) — left at their defaults, not worth removing.
#
# Legend:
#   [MANDATORY]       Required in every environment. Pod refuses to start
#                     without it (SystemExit(1) at Settings import time).
#   [MANDATORY:PROD]  Required whenever ENV is NOT one of
#                     {dev, development, local, test}. Enforced the same way.
#   [OPTIONAL]        Safe to omit. Consumers either gate themselves (e.g.
#                     `loki_read_configured()`, per-org DB config, feature
#                     flags) or the empty value carries a meaningful default
#                     (bool flag off; concurrency knob = 0 = disabled).
#
# Strict env-only: shared/config.py carries NO code-side defaults. Every
# value shown below is a sample to copy — not something the app falls back
# to at runtime.
#
# Source of truth: `shared/config.py` (MANDATORY_KEYS, MANDATORY_PROD_KEYS).
# =============================================================================


# -----------------------------------------------------------------------------
# Core identity
# -----------------------------------------------------------------------------

# [MANDATORY] Deployment environment name. Values in
# {dev, development, local, test} skip Tier-B (deployed-only) validation.
ENV=production

# [OPTIONAL] Pod role. Leave blank for API pods; set to "voice" on call
# worker pods (skips the full CRUD router import to shave startup time).
WORKER_MODE=


# -----------------------------------------------------------------------------
# Secrets source — Infisical
# -----------------------------------------------------------------------------

# [MANDATORY:PROD] Service-account token for Infisical secret retrieval.
INFISICAL_TOKEN=

# [MANDATORY:PROD] Infisical project UUID.
INFISICAL_PROJECT_ID=

# [OPTIONAL] Infisical environment slug (defaults to $ENV, then "dev").
INFISICAL_ENV=

# [OPTIONAL] Infisical server URL.
INFISICAL_HOST=https://secrets.trytone.ai


# -----------------------------------------------------------------------------
# Database & Redis
# -----------------------------------------------------------------------------

# [MANDATORY] PostgreSQL connection string.
DATABASE_URL=postgresql://tone:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tone

# [OPTIONAL] Alternate DB URL used by dev tooling (e.g. seed_built_in_tools).
STAGING_DATABASE_URL=

# [MANDATORY:PROD] Redis URL. The localhost value is rejected in deployed
# envs (INSECURE_PLACEHOLDERS in shared/config.py).
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# Cloudflare R2 (object storage — call recordings, ingestion artifacts)
# -----------------------------------------------------------------------------

# [MANDATORY:PROD] Cloudflare dashboard → R2 → Manage API tokens → create
# with Object Read & Write scoped to the bucket below.
R2_ACCESS_KEY_ID=
# [MANDATORY:PROD]
R2_SECRET_ACCESS_KEY=
# [MANDATORY:PROD] Create this bucket in the Cloudflare R2 dashboard first.
R2_BUCKET_NAME=noonstudio-tone-recordings
# [MANDATORY:PROD] Cloudflare dashboard → R2 → Overview → Account ID.
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com

# [OPTIONAL] R2 auth token (used by some tooling paths).
R2_TOKEN=


# -----------------------------------------------------------------------------
# Auth (JWT + cookies + CORS)
# -----------------------------------------------------------------------------

# [MANDATORY] HMAC signing key for access/refresh tokens. The literal
# "your-secret-key-here" is rejected (INSECURE_PLACEHOLDERS).
# Generate with: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=

# [OPTIONAL] Host-only cookie is correct here — single subdomain, no cross-
# subdomain sharing needed. Leave blank.
COOKIE_DOMAIN=

# [OPTIONAL] Real HTTPS via Caddy, so this should be true. ENV=production
# (not in DEV_ENV_NAMES) means it is NOT auto-forced to false — see
# shared/config.py.
COOKIE_SECURE=true

# [MANDATORY] One of "lax" | "strict" | "none". "none" REQUIRES COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# [MANDATORY] Exact CORS origins (comma-separated) — single-origin deploy
# (Caddy fronts both frontend and API on one host), so just the one origin.
CORS_ALLOW_ORIGINS=https://agents.noonstudio.africa

# [MANDATORY] Regex for CORS subdomains. Must be non-empty (empty aborts
# startup — it's Tier A, checked even though this is a single-origin deploy).
# Scoped to your real domain so any future subdomain (api.noonstudio.africa
# etc.) is covered without editing this again.
CORS_ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*noonstudio\.africa

# [MANDATORY] Default org id for single-tenant Core edition (~40 consumers).
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# [OPTIONAL] License key for Enterprise Edition; set SKIP_LICENSE_CHECK=true
# in dev to bypass.
TONE_LICENSE_KEY=

# [OPTIONAL] Skip license validation (bool). Empty = false.
# true: no TONE_LICENSE_KEY means Enterprise Edition code never mounts —
# only the MIT-licensed Core edition runs. Keep true unless/until you buy
# an EE license from tonehq.
SKIP_LICENSE_CHECK=true


# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------

# [MANDATORY] Frontend URL used in email links, magic-link redirects, etc.
APPLICATION_URL=https://agents.noonstudio.africa

# [MANDATORY] API base URL used by scripts and outbound helpers. Caddy routes
# /api/* on the same origin to the api container (see deploy/Caddyfile) —
# there's no separate api.* subdomain.
BASE_API_URL=https://agents.noonstudio.africa/api/v1

# [OPTIONAL] Bearer token for scripts hitting BASE_API_URL.
AUTH_TOKEN=


# -----------------------------------------------------------------------------
# Telephony
# -----------------------------------------------------------------------------

# [MANDATORY:PROD] Public base URL (scheme + host, no /api/v1) that Twilio
# can reach for outbound TwiML + status callbacks. Only matters once you
# actually wire up Twilio numbers — set now so startup doesn't abort.
BASE_CALL_URL=https://agents.noonstudio.africa

# [OPTIONAL] Twilio credentials (per-org config in DB overrides these).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# [OPTIONAL] Exotel credentials.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=

# [OPTIONAL] Daily.co / LiveKit (WebRTC transports).
DAILY_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WEBRTC_CLIENT_BASE_URL=

# [OPTIONAL] Call worker plumbing.
CALL_SERVER_HOST=
CALL_WORKER_INTERNAL_URL=

# [MANDATORY] Call worker routing / capacity.
CALL_WORKER_PREFIX=tone-call-worker
OUTBOUND_CALL_WORKER_PREFIX=tone-outbound-call-worker
OUTBOUND_CALL_HEADLESS_SERVICE=tone-outbound-call-headless
OUTBOUND_CALL_WORKER_PORT=8080
POD_SYNC_NAMESPACE=staging

# [MANDATORY] Per-pod concurrent-call ceiling (0 = unlimited, but you must
# still declare the value in strict-env-only mode).
MAX_CONCURRENT_CALLS=2

# [OPTIONAL] Per-batch outbound concurrency default (empty = 0 = unset).
MAX_CONCURRENT_OUTBOUND_CALLS=0

# [OPTIONAL] Background thread pool cap for outbound warm/refill
# (empty = 0 = on-demand).
OUTBOUND_BG_WORKERS=0

# [OPTIONAL] WebSocket "test bridge" trigger (agent-to-agent).
WS_CALL_TARGET_URL=
WS_CALL_TARGET_AGENT_ID=
WS_BRIDGE_INTERNAL_TOKEN=

# [OPTIONAL] Bool flags — empty = false.
WS_BRIDGE_ALLOW_INLINE=false
POD_PINNING_ENABLED=false

# [OPTIONAL] Enable /ws/test endpoint (MUST be false in production).
ENABLE_WS_TEST_ENDPOINT=false


# -----------------------------------------------------------------------------
# LLM providers (all OPTIONAL — per-org keys stored encrypted in DB
# override these; global values are fallbacks for helper features only)
# -----------------------------------------------------------------------------

# [OPTIONAL] Global fallback for helper features (e.g. system-prompt gen).
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=
GCP_SA_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
MINIMAX_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=
NGC_API_KEY=


# -----------------------------------------------------------------------------
# Speech-to-Text (STT) — all OPTIONAL
# -----------------------------------------------------------------------------

DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=

# STT tuning knobs (Nemotron / local models)
STT_MODEL=
STT_MAX_SANE_TTFB_S=5.0
STT_MAX_BUFFER_SEC=
STT_DECODE_MODE=
STT_STEP_MS=
STT_SILENCE_TICKS=

# vLLM endpoints (local-dev only)
VLLM_HTTP_URL=
VLLM_REALTIME_URL=


# -----------------------------------------------------------------------------
# Text-to-Speech (TTS) — all OPTIONAL
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=
LMNT_API_KEY=
RESEMBLE_API_KEY=
CARTESIA_API_KEY=
HUME_API_KEY=

TTS_MODEL=
TTS_SPEAKER=Ryan
TTS_LANGUAGE=English
TTS_ENGINE_URL=
PIPER_MODEL=/cache/en_US-lessac-medium.onnx
PIPER_SENTENCE_SILENCE=0.1


# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------

# [OPTIONAL] HubSpot MCP (pre-registered OAuth client).
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=
HUBSPOT_APP_ID=

# [OPTIONAL] Salesforce OAuth.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_MY_DOMAIN=

# [OPTIONAL] Google OAuth (Login with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Transactional email + SMS + LlamaCloud.
RESEND_API_KEY=
SEND_SMS_DEFAULT_TO_NUMBER=
LLAMA_CLOUD_API_KEY=


# -----------------------------------------------------------------------------
# Observability — Grafana Loki
# -----------------------------------------------------------------------------
# Log egress happens via the Alloy DaemonSet scraping pod stderr; these
# secrets are for READING per-call logs back from Loki (post-call sync).

# [MANDATORY:PROD] Loki push endpoint (…/loki/api/v1/push).
LOKI_URL=

# [OPTIONAL] Loki push credentials username.
LOKI_USER=

# [MANDATORY:PROD] Loki/Grafana auth token.
GRAFANA_API_KEY=

# [OPTIONAL] Explicit query endpoint (defaults to swapping /push → /query_range on LOKI_URL).
LOKI_QUERY_URL=
LOKI_QUERY_USER=
LOKI_QUERY_TOKEN=

# [OPTIONAL] Loki stream selector for per-call log fetch.
LOKI_SYNC_APP_LABEL=

# [MANDATORY] Per-call sync tuning (int knobs — empty would crash int()).
LOKI_SYNC_DELAY_SECONDS=120
LOKI_SYNC_PRE_BUFFER_SECONDS=30
LOKI_SYNC_POST_BUFFER_SECONDS=60
LOKI_SYNC_PAGE_LIMIT=5000
LOKI_SYNC_MAX_PAGES=50
LOKI_SYNC_HTTP_TIMEOUT=30
LOKI_SYNC_MAX_RETRIES=5

# [MANDATORY] Baseline log level (per-org / per-agent overrides in DB).
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Turn detection (selected per agent in conversation_settings.turn_detection)
# -----------------------------------------------------------------------------

# [OPTIONAL] TEN Turn Detection served through an OpenAI-compatible endpoint on a
# GPU host (see docs/TURN_DETECTION.md). The "ten" detector is offered in the agent
# editor only when this URL is set; Smart Turn and LiveKit need nothing here.
TEN_TURN_DETECTION_BASE_URL=
TEN_TURN_DETECTION_API_KEY=
TEN_TURN_DETECTION_MODEL=TEN_Turn_Detection

# [OPTIONAL] Comma-separated detector slugs to load during worker warm-up so the
# first call does not pay the model load (e.g. livekit).
TURN_DETECTION_PRELOAD=


# -----------------------------------------------------------------------------
# RAG (defaults consumed by IngestionRunService.resolve_run_config)
# -----------------------------------------------------------------------------

# [MANDATORY] All map to registry entries — empty would KeyError.
DEFAULT_PARSER=docling
DEFAULT_TOKENISER=docling_hybrid
# Set to google/gemini-embedding-001/3072 if you're using a Google key for
# embeddings instead of OpenAI (that's what we validated in dev) — must match
# whichever provider actually has a key configured below.
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536
DEFAULT_VECTOR_STORE=pgvector

# [OPTIONAL] Pinecone vector store — only needed when a run requests it.
PINECONE_API_KEY=

# [OPTIONAL] turbopuffer vector store — only needed when an ingestion config or
# run selects vector_store=turbopuffer. Both must be set; region is the
# turbopuffer region id (e.g. gcp-us-central1, aws-us-east-1). Namespaces are
# created per organisation and embedding size as <prefix>-<org id>-<dims>.
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=

# [OPTIONAL] Docling parser thread pool.
DOCLING_NUM_THREADS=4


# -----------------------------------------------------------------------------
# RAG evaluation harness
# -----------------------------------------------------------------------------

# [MANDATORY] All eval knobs must be declared.
EVAL_AUTO_RUN_ENABLED=true
EVAL_GENERATION_MODEL=gpt-4o
EVAL_ANSWER_MODEL=gpt-4o
EVAL_JUDGE_MODEL=gpt-4o
EVAL_TOP_K=8
EVAL_MAX_CONTEXT_CHARS=60000
# DeepEval judge — swap to "legacy" to use the in-repo custom LLM-as-judge.
EVAL_JUDGE_ENGINE=deepeval
EVAL_METRIC_THRESHOLD=0.7
EVAL_METRICS_ENABLED=faithfulness,answer_relevancy,contextual_precision,contextual_recall,contextual_relevancy,hallucination,correctness

# [MANDATORY] Metrics run per scenario by the per-agent LLM eval harness
# (evals/agent_llm_eval.py → AgentLlmEvalService). Every name must exist in
# core/services/evals/deepeval/metric_registry.SUPPORTED_METRICS; scenarios
# may override this list per-row via LLMScenario.metrics.
AGENT_LLM_EVAL_METRICS_ENABLED=answer_relevancy,bias,toxicity,persona_adherence,instruction_following


# -----------------------------------------------------------------------------
# Runtime / process control — all OPTIONAL
# -----------------------------------------------------------------------------

USE_SUBPROCESS_BOT=false
USE_WARM_POOL=false
WARM_POOL_SIZE=2
CALL_DRAIN_TIMEOUT_SECONDS=1800


# -----------------------------------------------------------------------------
# Build / infra (rarely set locally — Dockerfile / K8s manifests own these)
# -----------------------------------------------------------------------------

PIP_EXTRA_INDEX_URL=
HF_TOKEN=
HF_HOME=
KUBECONFIG=
GRPC_ENABLE_FORK_SUPPORT=
